{
  "version": 1,
  "purpose": "Curated workflow-intent patterns for the read-only IOTA AI guide. Patterns define logical steps only. Exact node names are resolved from the live backend node registry at request time.",
  "patterns": [
    {
      "id": "classification",
      "title": "Train a classification model",
      "keywords": [
        "classification",
        "classifier",
        "classify",
        "predict class",
        "train model",
        "طبقه بندی",
        "طبقه‌بندی",
        "کلاس بندی",
        "مدل طبقه بندی",
        "مدل طبقه‌بندی",
        "آموزش مدل"
      ],
      "steps": [
        {
          "id": "load_data",
          "catalog_query": "upload csv excel data input",
          "purpose": "Load the project dataset into the workflow.",
          "required": true
        },
        {
          "id": "inspect_data",
          "catalog_query": "data description inspection",
          "purpose": "Inspect columns, types, ranges, and basic data quality before modeling.",
          "required": false
        },
        {
          "id": "missing_values",
          "catalog_query": "missing values report",
          "purpose": "Check whether important columns contain missing values.",
          "required": false
        },
        {
          "id": "imputation",
          "catalog_query": "imputation missing values cleaning",
          "purpose": "Fill missing values when they cannot simply be left as-is.",
          "required": false,
          "condition": "Use only when the selected modeling columns contain missing values that need treatment."
        },
        {
          "id": "select_features_target",
          "catalog_query": "select features target ml data processing",
          "purpose": "Choose the input features and the classification target.",
          "required": true
        },
        {
          "id": "split",
          "catalog_query": "train test split",
          "purpose": "Separate training data from unseen test data.",
          "required": true
        },
        {
          "id": "scaling",
          "catalog_query": "scaler transformation",
          "purpose": "Scale numeric features for models that are sensitive to feature magnitude.",
          "required": false,
          "condition": "Usually useful for KNN, SVC, Linear SVC, and Logistic Regression; often unnecessary for tree-based models."
        },
        {
          "id": "model",
          "catalog_query": "classification models",
          "category": "ML Classification Models",
          "purpose": "Train a classification model.",
          "required": true,
          "selection": "Choose one implemented classifier based on the data and modeling goal."
        },
        {
          "id": "validate",
          "catalog_query": "model validation analysis",
          "purpose": "Evaluate model performance on validation/test predictions.",
          "required": true
        },
        {
          "id": "feature_importance",
          "catalog_query": "feature importance model analysis",
          "purpose": "Inspect which features contribute most when the selected model supports importance values.",
          "required": false
        }
      ]
    },
