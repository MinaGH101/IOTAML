# Runtime
APP_ENVIRONMENT=development
APP_NAME=IOTA ML API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true

# Authentication - replace before production
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=43200
USER_FILE=/app/app/data/user.json
CORS_ORIGINS=http://localhost:5174
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
RUN_RATE_LIMIT_PER_MINUTE=30
PROFILE_IMAGE_MAX_BYTES=10485760

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://iotaml:replace-me@postgres:5432/iotaml
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis is an accelerator; PostgreSQL remains the durable queue
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED_FOR_READINESS=false
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Storage: local or minio
STORAGE_BACKEND=minio
STORAGE_DIR=/app/storage
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_SECURE=false
ARTIFACT_BUCKET=iota-artifacts
ARTIFACT_SIGNED_URL_TTL_SECONDS=900
ARTIFACT_MAX_UPLOAD_BYTES=536870912
ARTIFACT_USER_QUOTA_BYTES=10737418240
ARTIFACT_PROJECT_QUOTA_BYTES=5368709120
ARTIFACT_DEFAULT_RETENTION_DAYS=30
ARTIFACT_PENDING_TIMEOUT_SECONDS=3600
ARTIFACT_RECONCILIATION_BATCH_SIZE=200

# API bounds
UPLOAD_PREVIEW_MAX_ROWS=100
UPLOAD_PREVIEW_MAX_COLUMNS=200
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200
API_MAX_RESPONSE_BYTES=10000000
MAX_WORKFLOW_NODES=500
MAX_WORKFLOW_PAYLOAD_BYTES=5000000

# Worker and queue
JOB_WORKER_CONCURRENCY=2
JOB_DEFAULT_TIMEOUT_SECONDS=7200
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_AFTER_SECONDS=45
JOB_RETRY_BASE_DELAY_SECONDS=10
JOB_RETRY_MAX_DELAY_SECONDS=900
JOB_MEMORY_LIMIT_MB=4096
JOB_CPU_LIMIT_SECONDS=7200
JOB_NETWORK_DISABLED=true
JOB_SHUTDOWN_GRACE_SECONDS=20
JOB_STDOUT_MAX_BYTES=2000000
JOB_STDERR_MAX_BYTES=2000000
JOB_RESULT_MAX_BYTES=50000000
JOB_RUNTIME_RETENTION_HOURS=72
MAX_ACTIVE_RUNS_PER_USER=4
MAX_ACTIVE_RUNS_PER_PROJECT=8

# Cache
NODE_CACHE_ENABLED=true
NODE_CACHE_RETENTION_DAYS=30
NODE_CACHE_CANDIDATES_PER_FINGERPRINT=8
NODE_CACHE_MAX_BYTES_PER_PROJECT=3221225472
NODE_CACHE_CLEANUP_BATCH_SIZE=200
WORKFLOW_VERSION_LIMIT=100

# Trusted single-tenant installations only. This is not a multi-tenant sandbox.
ALLOW_CUSTOM_CODE=false
CUSTOM_CODE_TIMEOUT_SECONDS=30
CUSTOM_CODE_MEMORY_MB=512

# Optional assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
