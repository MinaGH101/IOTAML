{
  "name": "no-code-ml-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "build": "tsc && vite build",
    "check": "npm run check:architecture && npm run lint && npm run typecheck && npm run lint:css && npm run check:theme && npm run check:css-debt && npm run test && npm run test:contracts && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "css:dedupe": "node scripts/dedupe-css.mjs",
    "check:architecture": "node scripts/check-feature-boundaries.mjs",
    "check:css-debt": "node scripts/check-css-debt.mjs",
    "check:theme": "node scripts/check-theme-contract.mjs",
    "test:e2e": "playwright test",
    "test:contracts": "node --test tests/unit/*.test.mjs tests/component/*.test.mjs tests/integration/*.test.mjs tests/performance/*.test.mjs",
    "lint": "node scripts/lint-source.mjs",
    "test:deployment": "node --test tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "@amcharts/amcharts5": "5.13.6",
    "@xyflow/react": "12.11.2",
    "gsap": "3.15.0",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "postcss": "8.5.17",
    "stylelint": "17.14.0",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  }
}
